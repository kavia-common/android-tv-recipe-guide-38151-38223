<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_card_background"/>
            <corners android:radius="@dimen/recipe_card_corner_radius"/>
            <stroke android:width="3dp" android:color="@color/tv_card_focused"/>
        </shape>
    </item>
    
    <!-- Normal state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_card_background"/>
            <corners android:radius="@dimen/recipe_card_corner_radius"/>
        </shape>
    </item>
</selector>
