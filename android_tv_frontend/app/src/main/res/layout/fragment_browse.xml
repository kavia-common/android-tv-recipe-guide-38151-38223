<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_background">

    <!-- Side Navigation -->
    <LinearLayout
        android:id="@+id/side_navigation"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/tv_card_background"
        android:paddingTop="@dimen/overscan_margin_vertical"
        android:paddingBottom="@dimen/overscan_margin_vertical"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_md"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recipe Guide"
            android:textSize="@dimen/text_size_title"
            android:textColor="@color/tv_text_primary"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="@dimen/spacing_xl"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/filter_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"/>

    </LinearLayout>

    <!-- Main Content Area -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingEnd="@dimen/overscan_margin_horizontal"
        android:paddingTop="@dimen/overscan_margin_vertical"
        android:paddingBottom="@dimen/overscan_margin_vertical"
        app:layout_constraintStart_toEndOf="@id/side_navigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Loading State -->
        <LinearLayout
            android:id="@+id/loading_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:indeterminateTint="@color/primary"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loading recipes..."
                android:textSize="@dimen/text_size_body"
                android:textColor="@color/tv_text_secondary"
                android:layout_marginTop="@dimen/spacing_lg"/>

        </LinearLayout>

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/empty_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No recipes found"
                android:textSize="@dimen/text_size_title"
                android:textColor="@color/tv_text_primary"
                android:layout_marginBottom="@dimen/spacing_md"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Try selecting a different filter"
                android:textSize="@dimen/text_size_body"
                android:textColor="@color/tv_text_secondary"/>

        </LinearLayout>

        <!-- Error State -->
        <LinearLayout
            android:id="@+id/error_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Failed to load recipes"
                android:textSize="@dimen/text_size_title"
                android:textColor="@color/error"
                android:layout_marginBottom="@dimen/spacing_md"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Please try again later"
                android:textSize="@dimen/text_size_body"
                android:textColor="@color/tv_text_secondary"/>

        </LinearLayout>

        <!-- Recipe Grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recipe_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:visibility="visible"/>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
